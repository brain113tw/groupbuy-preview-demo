



(function () {
	'use strict';

	function ready(fn) {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', fn);
		} else {
			fn();
		}
	}

	ready(function () {
		var form = document.getElementById('search');
		if (!form) { return; }

		var input = form.querySelector('input[name="keywords"]');
		var box   = document.getElementById('search_suggest');
		if (!input || !box) { return; }

		var DEBOUNCE_MS = 250;
		var MIN_LEN     = 1;

		var debounceTimer = null;
		var requestSeq    = 0;
		var lastSeq       = 0;
		var activeIndex   = -1;
		var items         = [];
		var xhr           = null;

		input.setAttribute('autocomplete', 'off');
		input.setAttribute('role', 'combobox');
		input.setAttribute('aria-expanded', 'false');
		input.setAttribute('aria-owns', 'search_suggest');
		input.setAttribute('aria-autocomplete', 'list');
		box.setAttribute('role', 'listbox');

		function escapeHtml(s) {
			return String(s)
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;');
		}

		function highlight(name, keyword) {
			var safeName = escapeHtml(name);
			var kw = keyword.trim();
			if (!kw) { return safeName; }
			var idx = safeName.toLowerCase().indexOf(escapeHtml(kw).toLowerCase());
			if (idx === -1) { return safeName; }
			return safeName.slice(0, idx) + '<mark>' + safeName.slice(idx, idx + kw.length) + '</mark>' + safeName.slice(idx + kw.length);
		}

		function closeBox() {
			box.hidden = true;
			box.innerHTML = '';
			items = [];
			activeIndex = -1;
			input.setAttribute('aria-expanded', 'false');
			input.removeAttribute('aria-activedescendant');
		}

		function setActive(index) {
			var options = box.querySelectorAll('.search-suggest-item');
			if (!options.length) { return; }

			if (activeIndex >= 0 && options[activeIndex]) {
				options[activeIndex].classList.remove('is-active');
			}

			activeIndex = index;
			if (activeIndex < 0) { activeIndex = options.length - 1; }
			if (activeIndex >= options.length) { activeIndex = 0; }

			var el = options[activeIndex];
			el.classList.add('is-active');
			input.setAttribute('aria-activedescendant', el.id);
			el.scrollIntoView({ block: 'nearest' });
		}

		function renderItems(data) {
			var goods = data.goods || [];

			if (!goods.length) {
				box.innerHTML = '<div class="search-suggest-empty">找不到符合的商品</div>';
				box.hidden = false;
				input.setAttribute('aria-expanded', 'true');
				items = [];
				activeIndex = -1;
				return;
			}

			var html = '';
			goods.forEach(function (g, i) {
				html += '<a href="' + escapeHtml(g.url) + '" class="search-suggest-item" id="search_suggest_item_' + i + '" role="option" data-index="' + i + '">' +
					'<img class="search-suggest-thumb" src="' + escapeHtml(g.thumb) + '" alt="" loading="lazy">' +
					'<span class="search-suggest-info">' +
						'<span class="search-suggest-name">' + highlight(g.name, data.keywords || '') + '</span>' +
						'<span class="search-suggest-price">' + escapeHtml(g.price) +
							(g.org_price ? '<del>' + escapeHtml(g.org_price) + '</del>' : '') +
						'</span>' +
					'</span>' +
				'</a>';
			});
			html += '<a href="search.php?keywords=' + encodeURIComponent(data.keywords || '') + '" class="search-suggest-more">查看全部搜尋結果 &rsaquo;</a>';

			box.innerHTML = html;
			box.hidden = false;
			input.setAttribute('aria-expanded', 'true');
			items = goods;
			activeIndex = -1;
		}

		function fetchSuggest(keyword) {
			var seq = ++requestSeq;

			if (xhr) {
				xhr.abort();
			}

			xhr = new XMLHttpRequest();
			xhr.open('GET', 'search_suggest.php?keywords=' + encodeURIComponent(keyword), true);
			xhr.onload = function () {
				if (seq < lastSeq) { return; }
				lastSeq = seq;

				if (xhr.status < 200 || xhr.status >= 300) { return; }

				var data;
				try {
					data = JSON.parse(xhr.responseText);
				} catch (e) {
					return;
				}

				if (input.value.trim() === '') {
					closeBox();
					return;
				}

				renderItems(data);
			};
			xhr.send();
		}

		input.addEventListener('input', function () {
			var val = input.value;

			if (debounceTimer) {
				clearTimeout(debounceTimer);
			}

			if (val.trim().length < MIN_LEN) {
				closeBox();
				return;
			}

			debounceTimer = setTimeout(function () {
				fetchSuggest(val.trim());
			}, DEBOUNCE_MS);
		});

		input.addEventListener('keydown', function (e) {
			var options = box.querySelectorAll('.search-suggest-item');

			if (box.hidden || !options.length) { return; }

			if (e.key === 'ArrowDown') {
				e.preventDefault();
				setActive(activeIndex + 1);
			} else if (e.key === 'ArrowUp') {
				e.preventDefault();
				setActive(activeIndex - 1);
			} else if (e.key === 'Enter') {
				if (activeIndex >= 0 && options[activeIndex]) {
					e.preventDefault();
					window.location.href = options[activeIndex].getAttribute('href');
				}
				 
			} else if (e.key === 'Escape') {
				closeBox();
			}
		});

		

		box.addEventListener('mousedown', function (e) {
			var link = e.target.closest('.search-suggest-item, .search-suggest-more');
			if (!link) { return; }
			e.preventDefault();
			window.location.href = link.getAttribute('href');
		});

		input.addEventListener('blur', function () {
			setTimeout(closeBox, 150);
		});

		input.addEventListener('focus', function () {
			if (input.value.trim().length >= MIN_LEN && box.innerHTML) {
				box.hidden = false;
			}
		});
	});
})();
