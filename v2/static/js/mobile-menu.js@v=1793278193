document.addEventListener('DOMContentLoaded', function () {
    // 手機抽屜選單（2026-09-26 改成左側滑出、平鋪列表；樣式在 style-customer-navigation.css）
    var button = document.getElementById('mobile-menu-toggle');
    var panel = document.querySelector('[data-mobile-nav]');
    if (!button || !panel) { return; }
    var overlay = document.getElementById('menu-overlay');
    if (!overlay) { overlay = document.createElement('div'); overlay.id = 'menu-overlay'; document.body.appendChild(overlay); }
    overlay.setAttribute('aria-hidden', 'true');
    button.setAttribute('aria-controls', panel.id);
    function icon(paths) { return '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">' + paths + '</svg>'; }
    var heading = document.createElement('div');
    heading.className = 'customer-menu-heading';
    heading.innerHTML = '<span class="customer-menu-title"></span><button type="button" class="customer-menu-close" aria-label="關閉選單">' + icon('<path d="M6 6l12 12M18 6 6 18"/>') + '</button>';
    /* 店名從頁首 og:site_name 拿（後台商店名稱）；用 textContent 放，不經過 innerHTML（2026-10-29，原本寫死） */
    var siteMeta = document.querySelector('meta[property="og:site_name"]');
    heading.querySelector('.customer-menu-title').textContent = (siteMeta && siteMeta.getAttribute('content')) || '選單';
    var search = document.createElement('form');
    search.className = 'customer-menu-search'; search.method = 'get'; search.setAttribute('action', 'search.php'); search.setAttribute('role', 'search');
    search.innerHTML = '<input type="search" name="keywords" placeholder="搜尋商品" aria-label="搜尋商品" autocomplete="off" enterkeyhint="search"><button type="submit" class="customer-menu-search-submit" aria-label="搜尋">' + icon('<circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/>') + '</button>';
    var searchInput = search.querySelector('input');
    var headerInput = document.querySelector('#search input[name="keywords"]');
    if (headerInput && headerInput.value) { searchInput.value = headerInput.value; }
    search.addEventListener('submit', function (e) { if (!searchInput.value.trim()) { e.preventDefault(); searchInput.focus(); } });
    /* 抽屜三組：線上選購（四區、團購專區在上面的選單列表，這裡接熱銷／最新）、購物與會員、關於我們（2026-10-29） */
    function group(label, items) {
        return '<p class="shop-drawer-label">' + label + '</p>' + items.map(function (s) { return '<a href="' + s[0] + '">' + icon(s[2]) + '<span>' + s[1] + '</span></a>'; }).join('');
    }
    var shortcuts = document.createElement('div');
    shortcuts.className = 'customer-menu-shortcuts';
    shortcuts.innerHTML = [
        group('購物與會員', [
            ['flow.php', '購物車', '<path d="M5 7h14l2 14H3zM8 8V6a4 4 0 0 1 8 0v2"/>'],
            ['user.php', '會員中心', '<circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/>'],
            ['user.php?act=order_list', '查訂單', '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/>']
        ]),
        group('關於我們', [
            ['index.php#store', '門市資訊', '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>']
        ])
    ].join('');
    var picks = document.createElement('div');
    picks.className = 'customer-menu-shortcuts shop-drawer-picks';
    picks.innerHTML = [
        ['search.php?intro=hot', '熱銷商品', '<path d="M12 3c1 4 5 5 5 10a5 5 0 0 1-10 0c0-2 1-3 2-4 0 2 1 3 2 3 0-3-1-5 1-9z"/>'],
        ['search.php?intro=new', '新品上架', '<path d="m12 3 2.5 5.5L20 9l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-.5z"/>']
    ].map(function (s) { return '<a href="' + s[0] + '">' + icon(s[2]) + '<span>' + s[1] + '</span></a>'; }).join('');
    var shopLabel = document.createElement('p');
    shopLabel.className = 'shop-drawer-label';
    shopLabel.textContent = '線上選購';
    var navList = panel.querySelector('ul');
    if (navList) { panel.insertBefore(shopLabel, navList); }
    panel.insertBefore(search, panel.firstChild); panel.insertBefore(heading, panel.firstChild); panel.appendChild(picks); panel.appendChild(shortcuts);
    var closeButton = heading.querySelector('button'), open = false, oldOverflow = '', oldBodyOverflow = '', submenus = [];
    function setSub(li, toggle, expanded) {
        if (expanded) {
            submenus.forEach(function (s) { if (s.li !== li) { s.li.classList.remove('customer-submenu-open'); s.toggle.setAttribute('aria-expanded', 'false'); } });
        }
        li.classList.toggle('customer-submenu-open', expanded); toggle.setAttribute('aria-expanded', String(expanded));
    }
    panel.querySelectorAll('li').forEach(function (li, i) {
        var sub = Array.prototype.find.call(li.children, function (child) { return child.classList.contains('sub_nav'); });
        var link = Array.prototype.find.call(li.children, function (child) { return child.tagName === 'A'; });
        if (!sub || !link) { return; }
        li.classList.add('has-customer-submenu'); sub.id = sub.id || 'customer-submenu-' + i;
        var toggle = document.createElement('button'); toggle.type = 'button'; toggle.className = 'customer-submenu-toggle';
        toggle.innerHTML = icon('<path d="m9 5 7 7-7 7"/>'); toggle.setAttribute('aria-label', link.textContent.trim() + ' 子選單');
        toggle.setAttribute('aria-expanded', 'false'); toggle.setAttribute('aria-controls', sub.id);
        toggle.addEventListener('click', function () { setSub(li, toggle, !li.classList.contains('customer-submenu-open')); });
        li.insertBefore(toggle, sub); submenus.push({ li: li, toggle: toggle });
        if (sub.querySelector('a.current')) { setSub(li, toggle, true); }
    });
    var closingTimer = 0;
    function setOpen(value) {
        if (value === open) { return; } open = value;
        if (open) { oldOverflow = document.documentElement.style.overflow; oldBodyOverflow = document.body.style.overflow; }
        document.body.classList.toggle('menu-open', open); button.setAttribute('aria-expanded', String(open));
        /* 收起動畫那 0.3 秒頁首層級要維持，不然底部導覽列會蓋在還沒滑走的抽屜上 */
        clearTimeout(closingTimer); document.body.classList.toggle('menu-closing', !open);
        if (!open) { closingTimer = setTimeout(function () { document.body.classList.remove('menu-closing'); }, 320); }
        document.documentElement.style.overflow = open ? 'hidden' : oldOverflow;
        document.body.style.overflow = open ? 'hidden' : oldBodyOverflow;
        if (open) { panel.setAttribute('role', 'dialog'); panel.setAttribute('aria-modal', 'true'); closeButton.focus(); }
        else { panel.removeAttribute('role'); panel.removeAttribute('aria-modal'); button.focus(); }
    }
    button.addEventListener('click', function () { setOpen(!open); });
    closeButton.addEventListener('click', function () { setOpen(false); });
    overlay.addEventListener('click', function () { setOpen(false); });
    document.addEventListener('keydown', function (e) {
        if (!open) { return; }
        /* 搜尋框有字時 Esc 只清字（瀏覽器內建），不關抽屜；清空後再按一次才關 */
        if (e.key === 'Escape') { if (document.activeElement === searchInput && searchInput.value) { return; } setOpen(false); }
        if (e.key === 'Tab') {
            var stops = Array.prototype.filter.call(panel.querySelectorAll('a[href],button,input'), function (el) { return el.getClientRects().length && !el.disabled; });
            var first = stops[0], last = stops[stops.length - 1];
            if (e.shiftKey && (document.activeElement === first || !panel.contains(document.activeElement))) { e.preventDefault(); last.focus(); }
            else if (!e.shiftKey && (document.activeElement === last || !panel.contains(document.activeElement))) { e.preventDefault(); first.focus(); }
        }
    });
    window.addEventListener('resize', function () { if (window.innerWidth > 800) { setOpen(false); } });
});



/* One snapshot and one response owner for wash, attributes and quantity. */
function changePrice() {
    var form = document.getElementById('purchase_form');
    var price = document.getElementById('pd_amount') || document.getElementById('ECS_GOODS_AMOUNT');
    if (!form || !price) { return; }
    var attrs = [];
    for (var i = 0; i < form.elements.length; i++) {
        var el = form.elements[i];
        if ((el.name || '').substr(0, 5) !== 'spec_' || el.name === 'spec_list') { continue; }
        if (((el.type === 'radio' || el.type === 'checkbox') && el.checked) || el.tagName === 'SELECT') {
            if (el.value) { attrs.push(el.value); }
        }
    }
    var quantity = form.elements['number'];
    var qty = parseInt(quantity ? quantity.value : 1, 10);
    if (!isFinite(qty) || qty < 1) { qty = 1; }
    if (quantity) { quantity.value = qty; }
    var washEl = form.querySelector('input[name="laundry_wash"]:checked');
    var data = {
        id: form.elements['goods_id'] ? form.elements['goods_id'].value : 0,
        attr: attrs.join(','), number: qty, wash: washEl ? washEl.value : ''
    };
    var key = [data.id, data.attr, data.number, data.wash].join('|');
    var state = form.laundryPriceState || (form.laundryPriceState = {sequence: 0});
    if (state.key === key && (state.pending || state.success)) { return; }
    state.key = key;
    state.success = false;
    state.pending = true;
    var sequence = ++state.sequence;
    if (state.request && typeof state.request.abort === 'function') { state.request.abort(); }
    price.setAttribute('aria-live', 'polite');
    price.setAttribute('aria-busy', 'true');
    price.textContent = '價格更新中…';
    var retry = document.getElementById('product-price-retry');
    if (retry) { retry.hidden = true; }

    function failure() {
        if (sequence !== state.sequence) { return; }
        state.pending = false;
        state.success = false;
        price.setAttribute('aria-busy', 'false');
        price.textContent = '價格更新失敗，請重試';
        if (!retry) {
            retry = document.createElement('button');
            retry.id = 'product-price-retry';
            retry.type = 'button';
            retry.textContent = '重新計算';
            /* 前台按鈕：觸控區至少 44px、字級 16px（手機才點得到、iOS 不放大） */
            retry.style.cssText = 'min-height:44px;min-width:44px;padding:8px 14px;margin-left:8px;font-size:16px;line-height:1.5;vertical-align:middle;cursor:pointer;';
            retry.addEventListener('click', changePrice);
            price.parentNode.insertBefore(retry, price.nextSibling);
        }
        retry.hidden = false;
    }
    if (typeof jQuery === 'undefined') { failure(); return; }
    state.request = jQuery.ajax({
        type: 'GET', url: 'goods.php?act=price', data: data,
        dataType: 'json', cache: false, timeout: 15000,
        success: function (response) {
            if (sequence !== state.sequence) { return; }
            if (!response || response.err_msg || response.err_no || typeof response.result !== 'string' || !response.result) {
                failure(); return;
            }
            state.pending = false;
            state.success = true;
            price.setAttribute('aria-busy', 'false');
            price.innerHTML = response.result;
        },
        error: function () { failure(); }
    });
}

document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('purchase_form');
    if (!form) { return; }
    form.addEventListener('change', function (event) {
        var name = event.target.name || '';
        if (name === 'laundry_wash' || name === 'number' || name.substr(0, 5) === 'spec_') { changePrice(); }
    });
    form.addEventListener('keyup', function (event) {
        if (event.target.name === 'number' && parseInt(event.target.value, 10) > 0) { changePrice(); }
    });
    changePrice();
});

document.addEventListener('DOMContentLoaded', function() {
    var quantitySelector = document.querySelector('.quantity-selector');
    if (!quantitySelector) {
        return;
    }

    var minusBtn = quantitySelector.querySelector('.btn-minus');
    var plusBtn = quantitySelector.querySelector('.btn-plus');
    var numberInput = quantitySelector.querySelector('#goods_number_input');

     
    if (minusBtn) {
        minusBtn.addEventListener('click', function() {
            var currentValue = parseInt(numberInput.value, 10) || 1; 
            if (currentValue > 1) {
                numberInput.value = currentValue - 1;
                changePrice(); 
            }
        });
    }

     
    if (plusBtn) {
        plusBtn.addEventListener('click', function() {
            var currentValue = parseInt(numberInput.value, 10) || 0; 
            var maxStock = numberInput.getAttribute('max');

            if (maxStock && currentValue >= parseInt(maxStock, 10)) {
                return; 
            }

            numberInput.value = currentValue + 1;
            changePrice();
        });
    }

     
    if (numberInput) {
        numberInput.addEventListener('keydown', function(event) {
            if (event.key === 'ArrowUp') {
                event.preventDefault(); 
                if(plusBtn) plusBtn.click(); 
            }
            else if (event.key === 'ArrowDown') {
                event.preventDefault(); 
                if(minusBtn) minusBtn.click(); 
            }
        });
    }
});
